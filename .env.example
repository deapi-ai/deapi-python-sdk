# DeAPI SDK configuration
# Copy this file to .env and fill in your values.
# Create an API key in your dashboard at https://deapi.ai
# Key format: sk-dp-<id>-<secret> (older "<id>|<secret>" keys keep working).
# Never commit a real key.

# Required for integration tests (pytest -m integration)
DEAPI_API_KEY=sk-dp-<id>-<secret>

# Optional overrides
# DEAPI_BASE_URL=https://api.deapi.ai
# DEAPI_API_VERSION=v2
# Set to 0 to stop the SDK filling unset parameters from the model card defaults
# DEAPI_FILL_MODEL_DEFAULTS=1
