# DeAPI SDK configuration
# Copy this file to .env and fill in your values.
# Create an API key in your dashboard at https://deapi.ai
# Key format: sk-dp-<id>-<secret> (older "<id>|<secret>" keys keep working).
# Never commit a real key.

# Required for integration tests (pytest -m integration)
DEAPI_API_KEY=sk-dp-<id>-<secret>

# Optional overrides
# DEAPI_BASE_URL=https://api.deapi.ai
# DEAPI_API_VERSION=v2   # only "v2" is accepted
# Set to 0 to stop the SDK filling unset parameters from the model card defaults
# DEAPI_FILL_MODEL_DEFAULTS=1

# Real-time status over WebSocket (pip install "deapi-sdk[ws] @ git+https://github.com/deapi-ai/deapi-python-sdk.git")
# The "Client ID" shown in your dashboard; pass client_id= explicitly when serving many users
# DEAPI_CLIENT_ID=your-client-id
# Only needed for non-production environments
# DEAPI_WS_URL=wss://soketi.deapi.ai
# DEAPI_WS_APP_KEY=depin-api-prod-key
